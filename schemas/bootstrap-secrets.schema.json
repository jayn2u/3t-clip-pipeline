{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://three-t.dev/schemas/bootstrap-secrets.schema.json",
  "title": "3T pipeline bootstrap secrets",
  "type": "object",
  "additionalProperties": false,
  "required": ["platform_secret_values"],
  "properties": {
    "platform_secret_values": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "three-t-registry-pull",
        "three-t-code-s3",
        "three-t-data-s3",
        "three-t-run-s3",
        "three-t-minio-root"
      ],
      "properties": {
        "three-t-registry-pull": {
          "type": "object",
          "additionalProperties": false,
          "required": [".dockerconfigjson"],
          "properties": {
            ".dockerconfigjson": {"type": "string", "minLength": 1}
          }
        },
        "three-t-code-s3": {"$ref": "#/$defs/s3"},
        "three-t-data-s3": {"$ref": "#/$defs/s3"},
        "three-t-run-s3": {"$ref": "#/$defs/s3"},
        "three-t-minio-root": {
          "type": "object",
          "additionalProperties": false,
          "required": ["rootUser", "rootPassword"],
          "properties": {
            "rootUser": {"type": "string", "minLength": 1},
            "rootPassword": {"type": "string", "minLength": 1}
          }
        }
      }
    }
  },
  "$defs": {
    "s3": {
      "type": "object",
      "additionalProperties": false,
      "required": ["endpoint", "bucket", "accessKey", "secretKey", "region"],
      "properties": {
        "endpoint": {"type": "string", "minLength": 1},
        "bucket": {"type": "string", "minLength": 1},
        "accessKey": {"type": "string", "minLength": 1},
        "secretKey": {"type": "string", "minLength": 1},
        "region": {"type": "string", "minLength": 1}
      }
    }
  }
}
