apiVersion: networking.k8s.io/v1
kind: Ingress
metadata:
  name: minio-tailscale
  namespace: three-t-pipeline
  annotations:
    tailscale.com/tags: tag:k8s
spec:
  ingressClassName: tailscale
  rules:
    - host: minio.example.ts.net
      http:
        paths:
          - path: /
            pathType: Prefix
            backend:
              service:
                name: minio
                port:
                  name: console
